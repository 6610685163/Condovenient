# Backend Configuration
PORT=3000

# Firebase
FIREBASE_PROJECT_ID=condovenient-project
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Bank API (สำหรับ Payment Verification)
BANK_API_URL=https://mock-bank-api.example.com
BANK_API_KEY=mock-api-key

# Database (หากใช้ PostgreSQL แทน Firebase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=condovenient
DB_USER=postgres
DB_PASSWORD=password

# JWT Secret (สำหรับ Token)
JWT_SECRET=your-secret-key-here

# Environment
NODE_ENV=development
